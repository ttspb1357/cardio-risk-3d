{
  "_note": "Display metadata per dataset column. 'ref' = typical adult reference range [low, high] (null = no bound). General guidance only; laboratories and guidelines differ. 'flag_if_present' marks yes/no findings that are clinically abnormal when present.",
  "groups": ["Demographics & history", "Examination", "Symptoms", "ECG", "Laboratory", "Echocardiography"],
  "features": {
    "Age":                  {"label": "Age", "unit": "years", "group": "Demographics & history", "desc": "Age in years."},
    "Sex":                  {"label": "Sex", "group": "Demographics & history", "desc": "Biological sex as recorded in the dataset."},
    "Weight":               {"label": "Weight", "unit": "kg", "group": "Demographics & history"},
    "Length":               {"label": "Height", "unit": "cm", "group": "Demographics & history"},
    "BMI":                  {"label": "BMI", "unit": "kg/m²", "ref": [18.5, 24.9], "group": "Demographics & history", "desc": "Body-mass index."},
    "DM":                   {"label": "Diabetes", "flag_if_present": true, "group": "Demographics & history", "desc": "Diabetes mellitus."},
    "HTN":                  {"label": "Hypertension", "flag_if_present": true, "group": "Demographics & history"},
    "Current Smoker":       {"label": "Current smoker", "flag_if_present": true, "group": "Demographics & history"},
    "EX-Smoker":            {"label": "Ex-smoker", "flag_if_present": true, "group": "Demographics & history"},
    "FH":                   {"label": "Family history of CAD", "flag_if_present": true, "group": "Demographics & history"},
    "Obesity":              {"label": "Obesity", "flag_if_present": true, "group": "Demographics & history", "desc": "Recorded as obese (BMI above 25 in this dataset)."},
    "CRF":                  {"label": "Chronic renal failure", "flag_if_present": true, "group": "Demographics & history"},
    "CVA":                  {"label": "Previous stroke (CVA)", "flag_if_present": true, "group": "Demographics & history"},
    "Airway disease":       {"label": "Airway disease", "flag_if_present": true, "group": "Demographics & history"},
    "Thyroid Disease":      {"label": "Thyroid disease", "flag_if_present": true, "group": "Demographics & history"},
    "CHF":                  {"label": "Congestive heart failure", "flag_if_present": true, "group": "Demographics & history"},
    "DLP":                  {"label": "Dyslipidemia", "flag_if_present": true, "group": "Demographics & history", "desc": "Abnormal blood lipids."},
    "BP":                   {"label": "Blood pressure (systolic)", "unit": "mmHg", "ref": [90, 129], "group": "Examination"},
    "PR":                   {"label": "Pulse rate", "unit": "bpm", "ref": [60, 100], "group": "Examination"},
    "Edema":                {"label": "Edema", "flag_if_present": true, "group": "Examination", "desc": "Swelling from fluid build-up."},
    "Weak Peripheral Pulse":{"label": "Weak peripheral pulse", "flag_if_present": true, "group": "Examination"},
    "Lung rales":           {"label": "Lung rales", "flag_if_present": true, "group": "Examination", "desc": "Crackling lung sounds."},
    "Systolic Murmur":      {"label": "Systolic murmur", "flag_if_present": true, "group": "Examination"},
    "Diastolic Murmur":     {"label": "Diastolic murmur", "flag_if_present": true, "group": "Examination"},
    "Typical Chest Pain":   {"label": "Typical chest pain", "flag_if_present": true, "group": "Symptoms", "desc": "Classic angina: exertional chest pain relieved by rest or nitrates."},
    "Dyspnea":              {"label": "Shortness of breath", "flag_if_present": true, "group": "Symptoms"},
    "Function Class":       {"label": "Functional class (0–3)", "ref": [0, 0], "group": "Symptoms", "desc": "Limitation of physical activity by symptoms (0 = none, 3 = severe)."},
    "Atypical":             {"label": "Atypical chest pain", "flag_if_present": true, "group": "Symptoms"},
    "Nonanginal":           {"label": "Non-anginal chest pain", "flag_if_present": true, "group": "Symptoms"},
    "LowTH Ang":            {"label": "Low-threshold angina", "flag_if_present": true, "group": "Symptoms", "desc": "Angina brought on by light effort."},
    "Q Wave":               {"label": "Q wave", "flag_if_present": true, "group": "ECG", "desc": "Pathological Q waves, a sign of previous infarction."},
    "St Elevation":         {"label": "ST elevation", "flag_if_present": true, "group": "ECG"},
    "St Depression":        {"label": "ST depression", "flag_if_present": true, "group": "ECG", "desc": "Often a sign of reduced blood flow to heart muscle."},
    "Tinversion":           {"label": "T-wave inversion", "flag_if_present": true, "group": "ECG"},
    "LVH":                  {"label": "Left ventricular hypertrophy", "flag_if_present": true, "group": "ECG"},
    "Poor R Progression":   {"label": "Poor R-wave progression", "flag_if_present": true, "group": "ECG"},
    "BBB":                  {"label": "Bundle branch block", "group": "ECG", "desc": "Conduction delay: none, left (LBBB) or right (RBBB)."},
    "FBS":                  {"label": "Fasting blood sugar", "unit": "mg/dL", "ref": [70, 99], "group": "Laboratory"},
    "CR":                   {"label": "Creatinine", "unit": "mg/dL", "ref": [0.6, 1.3], "group": "Laboratory", "desc": "Kidney function marker."},
    "TG":                   {"label": "Triglycerides", "unit": "mg/dL", "ref": [null, 149], "group": "Laboratory"},
    "LDL":                  {"label": "LDL cholesterol", "unit": "mg/dL", "ref": [null, 129], "group": "Laboratory", "desc": "'Bad' cholesterol."},
    "HDL":                  {"label": "HDL cholesterol", "unit": "mg/dL", "ref": [40, null], "group": "Laboratory", "desc": "'Good' cholesterol; low values raise risk."},
    "BUN":                  {"label": "Blood urea nitrogen", "unit": "mg/dL", "ref": [7, 20], "group": "Laboratory"},
    "ESR":                  {"label": "ESR", "unit": "mm/h", "ref": [0, 20], "group": "Laboratory", "desc": "Erythrocyte sedimentation rate, an inflammation marker."},
    "HB":                   {"label": "Hemoglobin", "unit": "g/dL", "ref": [12, 17.5], "group": "Laboratory"},
    "K":                    {"label": "Potassium", "unit": "mEq/L", "ref": [3.5, 5.0], "group": "Laboratory"},
    "Na":                   {"label": "Sodium", "unit": "mEq/L", "ref": [135, 145], "group": "Laboratory"},
    "WBC":                  {"label": "White blood cells", "unit": "/µL", "ref": [4000, 11000], "group": "Laboratory"},
    "Lymph":                {"label": "Lymphocytes", "unit": "%", "ref": [20, 40], "group": "Laboratory"},
    "Neut":                 {"label": "Neutrophils", "unit": "%", "ref": [40, 70], "group": "Laboratory"},
    "PLT":                  {"label": "Platelets", "unit": "×10³/µL", "ref": [150, 450], "group": "Laboratory"},
    "EF-TTE":               {"label": "Ejection fraction", "unit": "%", "ref": [50, null], "group": "Echocardiography", "desc": "Share of blood pumped out per beat, measured by transthoracic echo."},
    "Region RWMA":          {"label": "Wall-motion abnormality", "unit": "regions", "ref": [0, 0], "group": "Echocardiography", "desc": "Number of heart-wall regions moving abnormally on echo (0 = none)."},
    "VHD":                  {"label": "Valvular heart disease", "group": "Echocardiography", "desc": "Severity: none, mild, moderate or severe."}
  }
}
